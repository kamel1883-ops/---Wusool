# Copy to `.dev.vars` for local development only. Never commit real values.
APP_ENV=development

# Phase 2 defaults to the offline mock providers, so no credentials are needed:
#   analysis.ai_provider      = mock      (settings screen, default)
#   analysis.crawler_provider = mock      (settings screen, default)
#
# To switch to real providers, add these as Worker secrets (never in the
# browser, never in source) and change the provider in platform settings:
#   AI_PROVIDER=openai
#   AI_MODEL=gpt-4o-mini
#   AI_API_KEY=
#   AI_GATEWAY_URL=https://api.openai.com/v1
#   CRAWLER_PROVIDER=cloudflare
#   CRAWLER_ACCOUNT_ID=
#   CRAWLER_API_TOKEN=
#
# Later phases read other keys from the same server-side store:
#   EMAIL_PROVIDER_API_KEY=
#   WHATSAPP_PROVIDER_TOKEN=

# First-admin allowlist for /api/setup (server env only, never commit a value):
#   SETUP_ADMIN_EMAIL=

# --- Lead discovery ----------------------------------------------------------
# Discovered records are stored as potential leads (classification=potential)
# with their source link, discovery date, evidence and match score. Only a human
# stage change or recorded consent marks one as confirmed.
# Free, no-key open data: OpenStreetMap through Overpass (ODbL). One bounded
# query per run inside a Saudi city taken from the ideal-customer profile.
# LEAD_DATA_PROVIDER=openstreetmap
# Optional: point at a mirror or a self-hosted Overpass when the public one is busy.
# LEAD_DATA_API_URL=https://overpass-api.de/api/interpreter
# Seconds between runs per company; keeps repeated clicks off the shared service.
# LEAD_DISCOVERY_COOLDOWN_SECONDS=15
#
# Or a licensed lead-data provider (needs all three):
# LEAD_DATA_PROVIDER=
# LEAD_DATA_API_URL=
# LEAD_DATA_API_KEY=

# --- Social accounts and publishing (optional; the screens run without them) --
# 32 random bytes, base64. Required before any account can be connected:
#   SOCIAL_TOKEN_KEY=
# Meta app (Pages + Instagram). The redirect URI must point at
# /api/company/<companyId>/social/oauth/callback on this origin:
#   META_APP_ID=
#   META_APP_SECRET=
#   META_REDIRECT_URI=
# Google app (GA4, Search Console, Tag Manager, Business Profile discovery):
#   GOOGLE_CLIENT_ID=
#   GOOGLE_CLIENT_SECRET=
#   GOOGLE_REDIRECT_URI=
# Shared secret for the scheduler that drains due publish jobs:
#   JOBS_SECRET=
# After the provider approves advanced access, record it per platform:
#   social.access.facebook_page=approved  (platform setting, not a secret)
