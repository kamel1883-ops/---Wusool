{
  "name": "wusool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Wusool — multi-tenant marketing intelligence SaaS (Phase 1: platform foundation)",
  "scripts": {
    "dev:web": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "db:migrate": "wrangler d1 execute wusool-db --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute wusool-db --remote --file=migrations/0001_init.sql"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wrangler": "^4.20.0"
  }
}
